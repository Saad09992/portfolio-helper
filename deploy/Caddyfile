# Caddy on VPS host. Routes 2 apps behind 1 ngrok tunnel.
#
# Flow: ngrok http 80  -->  Caddy :80  -->  app on 127.0.0.1
#
# Visit:
#   https://<ngrok-domain>/psx       -> psx-portfolio container
#   https://<ngrok-domain>/license   -> license-server container
#   https://<ngrok-domain>/          -> small index (edit below)

{
	# global options
	admin off
	auto_https off

	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# psx (built with BASE_PATH=/psx/)
	handle_path /psx/* {
		reverse_proxy 127.0.0.1:3000
	}

	# license (dotnet, requires UsePathBase("/license"))
	handle_path /license/* {
		reverse_proxy 127.0.0.1:8080
	}

	# root landing
	handle {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><meta charset=utf-8><title>apps</title><style>body{font-family:system-ui;padding:2rem;max-width:40rem;margin:auto}</style><h1>Apps</h1><ul><li><a href="/psx/">PSX Portfolio</a></li><li><a href="/license/">License Server</a></li></ul>` 200
	}
}
